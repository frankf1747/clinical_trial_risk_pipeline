# local = Spark on this machine, files under DATA_DIR
# cloud = Spark on Dataproc, files under gs://GCP_BUCKET (M5)
MODE=local
DATA_DIR=data

# Data gates
MIN_TRIALS=40000
MIN_MATCH_RATE=0.65       # observed 0.669 on the Q1 2004-2020 sample

# FAERS sample: Q1 of each year 2004-2020. Full history: FAERS_YEARS=2004-2026, FAERS_QUARTERS=1,2,3,4
FAERS_YEARS=2004-2020
FAERS_QUARTERS=1

# Cloud (M5)
GCP_BUCKET=
