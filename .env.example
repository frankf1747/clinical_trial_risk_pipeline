# local = Spark on this machine, files under DATA_DIR
# cloud = Spark on Dataproc, files under gs://GCP_BUCKET (M5)
MODE=local
DATA_DIR=data

# Data gates
MIN_TRIALS=40000
MIN_MATCH_RATE=0.65       # observed 0.669 on the Q1 2004-2020 sample

# FAERS sample: Q1 of each year 2004-2020. Full history: FAERS_YEARS=2004-2026, FAERS_QUARTERS=1,2,3,4
FAERS_YEARS=2004-2020
FAERS_QUARTERS=1

# M6 audit: monthly AACT flat-file archives 2017-01 .. 2021-01, as local zips named YYYYMMDD_*.zip.
# AACT serves them after sign-in: https://aact.ctti-clinicaltrials.org/snapshots -> Snapshot history ->
# Flat Text Files, one year at a time. Downloads redirect to signed URLs, so save the zips locally and name
# each by the latest last_changed_date in its studies.txt (docs/audits/2026-09-30-point-in-time.md).
# Each is extracted, reduced to the 2017-2020 cohort, and the extract deleted.
AACT_ARCHIVES=

# GCS bucket for Parquet (M3) and Dataproc (M5)
GCP_BUCKET=clinical-trial-risk-frankfu

# Snowflake (key-pair auth; see README)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_FILE=~/.snowflake/rsa_key.p8
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=CTRISK_WH
SNOWFLAKE_DATABASE=CTRISK
SNOWFLAKE_SCHEMA=PIPELINE
